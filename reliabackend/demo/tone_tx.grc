options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: demo_tx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: RELIA tone spectrum demo
    window_size: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: center_freq
  id: variable
  parameters:
    comment: ''
    value: '2450'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 448
    - 12.0
    rotation: 0
    state: true
- name: device_url
  id: variable
  parameters:
    comment: ''
    value: '"192.168.3.1"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 568
    - 20.0
    rotation: 0
    state: true
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '600000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 184
    - 12
    rotation: 0
    state: enabled
- name: start_freq
  id: variable
  parameters:
    comment: ''
    value: center_freq*1000000 - samp_rate/2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 704
    - 20.0
    rotation: 0
    state: true
- name: step
  id: variable
  parameters:
    comment: ''
    value: samp_rate/vec_len
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 944
    - 20.0
    rotation: 0
    state: true
- name: stop_freq
  id: variable
  parameters:
    comment: ''
    value: center_freq*1000000 + samp_rate/2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 824
    - 20.0
    rotation: 0
    state: true
- name: vec_len
  id: variable
  parameters:
    comment: ''
    value: '1024'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 320
    - 12.0
    rotation: 0
    state: true
- name: analog_sig_source_x_0
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '0.5'
    comment: ''
    freq: '75000'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    type: complex
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 360
    - 308.0
    rotation: 0
    state: true
- name: iio_pluto_sink_0
  id: iio_pluto_sink
  parameters:
    affinity: ''
    alias: ''
    attenuation1: '40'
    bandwidth: '600000'
    buffer_size: '32768'
    comment: ''
    cyclic: 'False'
    filter: ''
    filter_source: '''Auto'''
    fpass: '0'
    frequency: center_freq*1000000
    fstop: '0'
    len_tag_key: ''
    samplerate: samp_rate
    type: fc32
    uri: device_url
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 968
    - 332.0
    rotation: 0
    state: enabled
connections:
- - analog_sig_source_x_0
  - '0'
  - iio_pluto_sink_0
  - '0'
metadata:
  file_format: 1
